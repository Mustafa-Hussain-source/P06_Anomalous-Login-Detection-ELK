<!--
Add this to your Wazuh manager ossec.conf (active-response section).
Paths here are examples; adjust to your Wazuh install.
-->
<active-response>
  <command>alds_account_lock</command>
  <location>server</location>
  <rules_id>100101</rules_id>
</active-response>
<active-response>
  <command>alds_ip_block</command>
  <location>server</location>
  <rules_id>100102</rules_id>
</active-response>
<active-response>
  <command>alds_session_kill</command>
  <location>server</location>
  <rules_id>100103</rules_id>
</active-response>
<active-response>
  <command>alds_mfa_stepup</command>
  <location>server</location>
  <rules_id>100104</rules_id>
</active-response>

<command>
  <name>alds_account_lock</name>
  <executable>python3</executable>
  <extra_args>/opt/alds/wazuh/active-response/account_lock.py</extra_args>
</command>
<command>
  <name>alds_ip_block</name>
  <executable>python3</executable>
  <extra_args>/opt/alds/wazuh/active-response/ip_block.py</extra_args>
</command>
<command>
  <name>alds_session_kill</name>
  <executable>python3</executable>
  <extra_args>/opt/alds/wazuh/active-response/session_kill.py</extra_args>
</command>
<command>
  <name>alds_mfa_stepup</name>
  <executable>python3</executable>
  <extra_args>/opt/alds/wazuh/active-response/mfa_stepup.py</extra_args>
</command>
